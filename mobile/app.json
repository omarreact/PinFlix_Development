{
  "expo": {
    "name": "PinFlix",
    "slug": "pinflix-mobile",
    "scheme": "pinflix",
    "version": "2.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.pincodeit.pinflix.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.pincodeit.pinflix.mobile",
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "expo-notifications",
      "expo-screen-orientation"
    ],
    "extra": {
      "apiOrigin": "https://pinflix.pincodeit.com"
    },
    "updates": {
      "enabled": false
    }
  }
}
