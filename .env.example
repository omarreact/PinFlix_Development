# Provider request timeout in milliseconds, clamped to 1000..30000.
CINEPLEX_REQUEST_TIMEOUT_MS=4500

# Enable provider playback only after its integration is approved.
CINEPLEX_PLAYBACK_AUTHORIZED=false
# Explicit opt-in for the authorized media proxy; off by default.
PINFLIX_MEDIA_PROXY_ENABLED=false
# Generate a private 32+ character HMAC key. Never expose to client JavaScript.
MEDIA_PROXY_SECRET=
# Downloads require separate approval and streaming permission.
PINFLIX_DOWNLOADS_AUTHORIZED=false
PINFLIX_MATURE_ENABLED=false

# Optional email/password accounts and private Firestore libraries.
# Set credentials for the intended PinFlix Firebase project only.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# Optional approved promotional videos on hosts permitted by next.config.mjs.
PINFLIX_MARVEL_PROMO_URL=
PINFLIX_DC_PROMO_URL=

# Local QA only. Keep both disabled for public deployments.
PINFLIX_OFFLINE_CATALOGUE=false
PINFLIX_TEST_MEDIA=false
