# PinFlix · optional server configuration
# A fresh install needs NO .env.local file or API key.
# Movies, TV episodes, HLS/MP4 relay and LAN access work without manual setup.

# Advanced: disable playback, for operators who only want catalog browsing.
PINFLIX_PLAYBACK_DISABLED=false
PINFLIX_MEDIA_PROXY_DISABLED=false

# Advanced: larger shared deployments (Vercel multi-instance, distributed hosting)
# can provide the same 32+ character secret to every replica.
# For standard downloaded/local use, PinFlix generates this automatically.
# MEDIA_PROXY_SECRET=

# Optional: CineplexBD request timeout (milliseconds, 1000..30000)
CINEPLEX_REQUEST_TIMEOUT_MS=8000

# Downloads are separate from ordinary watching and remain opt-in.
PINFLIX_DOWNLOADS_AUTHORIZED=false
PINFLIX_MATURE_ENABLED=false

# Optional Firebase account sync; not necessary for guest watchlists.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# Browse a local CineplexBD-derived catalogue snapshot when offline.
# This cannot substitute for live video streaming.
PINFLIX_OFFLINE_CATALOGUE=false
