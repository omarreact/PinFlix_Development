{
  "name": "pinflix-ebn",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "setup:lan": "node scripts/setup-lan.cjs",
    "repair:local": "node scripts/repair-local.cjs",
    "build": "next build",
    "prestart": "node scripts/ensure-build.cjs",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "tsx scripts/integration.ts",
    "verify:root": "node scripts/verify-root.cjs",
    "verify:vercel": "node scripts/verify-vercel.cjs",
    "colors:generate": "tsx scripts/precompute-poster-colors.ts",
    "prebuild": "npm run colors:generate",
    "predev": "npm run colors:generate"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "hls.js": "1.7.3",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
